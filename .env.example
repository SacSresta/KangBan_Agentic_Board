# Copy this file to .env in the application root. Never commit .env.
# Put actual credentials only in .env. In Settings, enter the variable NAME.
# Leave values blank when using the default deterministic provider.
ENGINEER_API_KEY=
FRONTIER_API_KEY=

# Optional overrides. Relative data paths are resolved from the backend's cwd.
# KANBAN_DATA_DIR=/absolute/path/to/private/kanban-data
# KANBAN_PYTHON=/absolute/path/to/python/with/this/project/installed

# Restart the Python backend after changing .env. Electron may reuse a backend.
# KANBAN_PYTHON must be in Electron's process environment to select its interpreter.
